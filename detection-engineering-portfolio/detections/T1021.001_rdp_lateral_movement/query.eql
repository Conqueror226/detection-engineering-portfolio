// Hypothesis:
//   An attacker performing hands-on-keyboard lateral movement via RDP will
//   produce a successful RemoteInteractive logon (Windows LogonType 10),
//   immediately followed by process execution under the same account on the
//   same host. Isolated RDP logons are noisy; RDP logon *followed by* process
//   activity by the same identity is the higher-fidelity signal.
//
// Data sources:
//   - Windows Security Event Log 4624 (successful logon)
//   - Sysmon Event ID 1 / process.start
//
// Notes:
//   - LogonType 10 = RemoteInteractive (RDP).
//   - Local/loopback source addresses are excluded to reduce noise.

sequence by winlog.computer_name with maxspan=1m
  [ authentication where
      event.code == "4624" and
      winlog.event_data.LogonType == "10" and
      event.outcome == "success" and
      not winlog.event_data.IpAddress in ("-", "127.0.0.1", "::1", "0.0.0.0")
  ] by winlog.event_data.TargetUserName
  [ process where event.type == "start" ] by user.name
